# --- Custom prompt (no framework) ---
autoload -Uz vcs_info
precmd() { vcs_info }

zstyle ':vcs_info:git:*' formats '%F{cyan} on %b%f'
zstyle ':vcs_info:*' enable git

setopt PROMPT_SUBST

PROMPT='%F{red}%n%f on %F{yellow}%m%f at %F{green}%~%f${vcs_info_msg_0_}
%(?.%F{green}.%F{red})➜%f '

# --- ranger with cd-on-quit ---
function ranger-cd {
    local IFS=$'\t\n'
    local tempfile="$(mktemp -t tmp.XXXXXX)"
    ranger --choosedir="$tempfile" "${@:-$PWD}"
    if chosen_dir="$(cat -- "$tempfile")" && [ -n "$chosen_dir" ] && [ "$chosen_dir" != "$PWD" ]; then
        cd -- "$chosen_dir"
    fi
    rm -f -- "$tempfile"
}
alias fm='ranger-cd'
