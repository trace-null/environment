# Terminal-only ZSH config, installed system-wide by install-terminal.sh.
# Personal changes belong in each user's own ~/.zshrc, which loads after this.

# Leave root alone, even if root starts zsh (for example with sudo -s)
[ "$EUID" -eq 0 ] && return

# --- History ---
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

# --- Completion ---
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select

# --- Custom prompt (no framework) ---
autoload -Uz vcs_info add-zsh-hook
add-zsh-hook precmd vcs_info

zstyle ':vcs_info:git:*' formats '%F{cyan} on %b%f'
zstyle ':vcs_info:*' enable git

setopt PROMPT_SUBST

PROMPT='%F{red}%n%f on %F{yellow}%m%f at %F{green}%~%f${vcs_info_msg_0_}
%(?.%F{green}.%F{red})>%f '

# --- ranger with cd-on-quit ---
function ranger-cd {
    local IFS=$'\t\n'
    local tempfile="$(mktemp -t tmp.XXXXXX)"
    ranger --choosedir="$tempfile" "${@:-$PWD}"
    if chosen_dir="$(cat -- "$tempfile")" && [ -n "$chosen_dir" ] && [ "$chosen_dir" != "$PWD" ]; then
        cd -- "$chosen_dir"
    fi
    rm -f -- "$tempfile"
}
alias fm='ranger-cd'
